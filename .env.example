# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.

# Tavily Search API — used in Step 3 for news/council retrieval.
# Get a key at https://tavily.com
TAVILY_API_KEY=your-tavily-key-here

# --- LLM backend selection -------------------------------------------------
# Which provider the classification agent calls. Options: anthropic (default) | bedrock
LLM_BACKEND=anthropic

# Backend A: Anthropic API (zero-setup path for anyone cloning the repo).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional model override:
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Backend B: Claude via Amazon Bedrock using local AWS credentials.
# Set LLM_BACKEND=bedrock above, then provide a profile + region. For SSO,
# run `aws sso login --profile <name>` first. Nothing here is committed.
# AWS_PROFILE=your-aws-profile
# AWS_REGION=eu-west-2
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Agentic classifier (optional) -----------------------------------------
# Max web searches the LangGraph ReAct agent may run per project (cost cap).
# AGENT_MAX_SEARCHES=5
